# Copiar a .env antes de levantar docker compose

# Postgres
POSTGRES_USER=maestro
POSTGRES_PASSWORD=maestro_dev_password
POSTGRES_DB=maestro

# URLs internas (usadas por los contenedores entre sí, vía nombres de servicio Docker)
DATABASE_URL=postgresql://maestro:maestro_dev_password@postgres:5432/maestro
REDIS_URL=redis://redis:6379

# URL pública del backend, usada por el frontend en el navegador
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del frontend, usada por el backend para CORS
FRONTEND_URL=http://localhost:3000

# --- Sprint 2: Agente Investigador ---

# Tavily: búsqueda web. https://app.tavily.com
TAVILY_API_KEY=

# Firecrawl: scraping de contenido completo. https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# Anthropic: síntesis de la investigación con Claude.
ANTHROPIC_API_KEY=

# Opcional: embeddings reales para el caché semántico (Qdrant).
# Sin esto, el caché usa un hash determinístico de respaldo que
# solo detecta prompts IDÉNTICOS, no semánticamente similares.
OPENAI_API_KEY=

# Qdrant (caché semántico) — no necesita key, solo URL interna.
# Ya configurada en docker-compose.yml como http://qdrant:6333
