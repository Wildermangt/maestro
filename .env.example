# Copiar a .env antes de levantar docker compose

# Postgres
POSTGRES_USER=maestro
POSTGRES_PASSWORD=maestro_dev_password
POSTGRES_DB=maestro

# URLs internas (usadas por los contenedores entre sí, vía nombres de servicio Docker)
DATABASE_URL=postgresql://maestro:maestro_dev_password@postgres:5432/maestro
REDIS_URL=redis://redis:6379

# Crea un usuario de prueba con ID fijo al arrancar el backend. Útil en
# desarrollo local (no hay Firebase Auth todavía) — en Railway con
# usuarios reales, deja esto sin definir o en false.
RUN_SEED=true

# URL pública del backend, usada por el frontend en el navegador
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del frontend, usada por el backend para CORS
FRONTEND_URL=http://localhost:3000

# --- Sprint 2: Agente Investigador ---

# Tavily: búsqueda web. https://app.tavily.com
TAVILY_API_KEY=

# Firecrawl: scraping de contenido completo. https://www.firecrawl.dev
FIRECRAWL_API_KEY=

# --- Proveedor de LLM ---
#
# Qué modelo usan TODOS los agentes (Director, Investigador, Analista,
# Presentador, Diseñador). Valores válidos: claude | openai | gemini
# Si no defines nada, se usa claude.
#
# Solo necesitas la API key del proveedor que elijas aquí. Si eliges uno
# y su key está vacía, el worker te lo dirá con un mensaje explícito al
# arrancar, en vez de fallar de forma silenciosa.
LLM_PROVIDER=claude

# Anthropic: síntesis de la investigación con Claude.
ANTHROPIC_API_KEY=

# OpenAI: se usa como proveedor de LLM si LLM_PROVIDER=openai, y además
# (siempre, opcionalmente) para los embeddings reales del caché semántico
# de Qdrant. Sin esta key el caché usa un hash determinístico de respaldo
# que solo detecta prompts IDÉNTICOS, no semánticamente similares.
OPENAI_API_KEY=

# Google Gemini: solo necesario si LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# Opcional: fijar un modelo distinto al por defecto de cada proveedor.
# Por defecto: claude-sonnet-5 / gpt-4o / gemini-2.0-flash
ANTHROPIC_MODEL=
OPENAI_MODEL=
GEMINI_MODEL=

# Qdrant (caché semántico).
# Desarrollo local: NO necesitas llenar esto — docker-compose.yml ya fija
# QDRANT_URL=http://qdrant:6333 directamente para el contenedor local,
# sin autenticación. Las dos variables de abajo solo importan para Railway.
# Producción en Railway (Sprint 5): no hay plugin gestionado de Qdrant en
# Railway, así que se usa Qdrant Cloud (tier gratuito) — configura estas
# dos variables en el dashboard de Railway, no aquí.
# https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# --- Sprint 4: Agente Diseñador Web (deploy a Vercel) ---

# Vercel: deploy automático del sitio generado. https://vercel.com/account/tokens
VERCEL_TOKEN=

# --- Sprint 6: Canal de Telegram ---

# Token del bot, obtenido de @BotFather en Telegram. Formato: NNNNNNNNN:AAH...
TELEGRAM_BOT_TOKEN=

# Tu chat_id personal, obtenido de @userinfobot en Telegram. Solo este
# chat puede crear tareas y recibe las notificaciones de resultado —
# cualquier otro chat que le escriba al bot es ignorado en silencio.
TELEGRAM_CHAT_ID=

# --- Sprint 6: Canal de Gmail (lectura + envío bidireccional) ---
#
# Requiere OAuth2 (las contraseñas de aplicación de Google ya no están
# disponibles para muchas cuentas). Pasos:
#   1. console.cloud.google.com -> crear proyecto -> habilitar "Gmail API"
#   2. "OAuth consent screen" -> External -> agregar tu correo como test user
#   3. "Credentials" -> "+ Create Credentials" -> "OAuth client ID" ->
#      Application type: "Desktop app"
#   4. Descargar el JSON de esas credenciales
#   5. cd workers && pip install google-auth-oauthlib --break-system-packages
#      python channels/oauth_scripts/gmail_authorize.py /ruta/al/client_secret.json
#   6. Copiar las 3 líneas que el script imprime, aquí abajo:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Lista separada por comas de remitentes autorizados a crear tareas por
# correo. SIN ESTO el canal no arranca — es la única barrera contra que
# cualquiera que conozca tu dirección de Gmail cree tareas a tu costo.
GMAIL_ALLOWED_SENDERS=

# Opcional, default 60 segundos.
GMAIL_POLL_INTERVAL_SECONDS=

# --- Sprint 6: Canal de Outlook (lectura + envío bidireccional) ---
#
# Requiere OAuth2 vía Microsoft Graph. Pasos:
#   1. portal.azure.com -> "App registrations" -> "New registration"
#      Nombre: "Prompt Maestro". Supported account types: "Personal
#      Microsoft accounts only". Redirect URI: Public client/native,
#      valor http://localhost
#   2. Copiar el "Application (client) ID"
#   3. "API permissions" -> agregar Mail.Read y Mail.Send (Delegated)
#   4. "Authentication" -> confirmar "Allow public client flows" = Yes
#   5. cd workers && pip install msal --break-system-packages
#      python channels/oauth_scripts/outlook_authorize.py <client-id>
#   6. Copiar las 2 líneas que el script imprime, aquí abajo:
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=

# Mismo propósito que GMAIL_ALLOWED_SENDERS — obligatorio.
OUTLOOK_ALLOWED_SENDERS=

# Opcional, default 60 segundos.
OUTLOOK_POLL_INTERVAL_SECONDS=
